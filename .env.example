# Copy to .env (git-ignored) before `docker compose up`. Every value here is a placeholder.

# MySQL root password for the compose mysql container (only applied when the mysql-data volume is first created;
# an older volume keeps its old password, so reuse it here or run `docker compose down -v`)
MYSQL_ROOT_PASSWORD=change-me-local-only
# Credentials the services use to reach MySQL (root until Phase 1 adds per-service users)
DB_USERNAME=root
DB_PASSWORD=change-me-local-only
# HS256 signing key shared by gateway and services; at least 32 bytes
JWT_SECRET=change-me-to-at-least-32-bytes-of-random-text
# Gmail address + App Password; leave empty to log mails instead of sending
MAIL_USERNAME=
MAIL_PASSWORD=
